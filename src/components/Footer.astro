---
// White footer: logo, address, main number, future sections and legal pages as FutureLink, current year.
import { Image } from "astro:assets";
import logo from "../assets/logo.png";
import FutureLink from "./FutureLink.astro";
import { ADDRESS, PHONE_MAIN, SOON } from "../data/clinic";
const year = new Date().getFullYear();
const soon = ["Ціни", "Лікарі", "Політика конфіденційності", "Публічний договір"];
---
<footer class="site-footer">
  <div class="container footer__inner">
    <a class="footer__logo" href="#top">
      <Image src={logo} alt="Медбуд, лікарня — на початок сторінки" width={130} height={52} densities={[1, 2]} format="webp" loading="lazy" />
    </a>
    <div class="footer__contact">
      <p>{ADDRESS.full}</p>
      <p class="footer__phone-row">Телефон: <a class="footer__phone" href={PHONE_MAIN.href}>{PHONE_MAIN.display}</a></p>
    </div>
    <ul role="list" class="footer__links">
      {soon.map((s) => <li><FutureLink note={SOON} class="footer__soon">{s}</FutureLink></li>)}
    </ul>
    <p class="footer__copy">© {year} ДП «Медбуд»</p>
  </div>
</footer>

<style>
  .site-footer { background: var(--color-bg); border-top: 1px solid var(--color-line); }
  .footer__inner {
    display: grid;
    gap: var(--s-3);
    padding-block: var(--s-5) var(--s-4);
    font-size: 1rem;
  }
  .footer__logo { display: inline-flex; width: max-content; border-radius: var(--radius); }
  .footer__logo img { width: 120px; height: auto; }
  .footer__contact { display: grid; gap: var(--s-1); color: var(--color-text-muted); }
  .footer__phone {
    width: max-content;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    font-weight: 500;
    font-size: 1.125rem;
    color: var(--color-text);
    text-decoration: none;
    transition: color var(--dur-fast) var(--ease-out);
  }
  .footer__phone:hover { color: var(--color-accent); }
  .footer__links { display: flex; flex-wrap: wrap; gap: var(--s-1) var(--s-3); }
  .footer__links :global(.footer__soon) { min-height: 44px; color: var(--color-text-muted); }
  .footer__copy { color: var(--color-text-muted); font-size: var(--fs-caption); }
  @media (min-width: 1024px) {
    .footer__inner {
      grid-template-columns: auto minmax(0, 1fr) auto;
      align-items: start;
      column-gap: var(--s-5);
    }
    .footer__links { grid-column: 2 / 4; grid-row: 1; justify-content: flex-end; }
    .footer__contact { grid-column: 2; grid-row: 2; }
    .footer__copy { grid-column: 3; grid-row: 2; align-self: end; }
    .footer__logo { grid-row: 1 / 3; }
  }
</style>
